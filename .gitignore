# ─── Python Cache & Compiled Files ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ─── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Virtual Environments (teammates install their own via requirements.txt) ──
venv/
env/
ENV/
.venv/

# ─── Test Cache ───────────────────────────────────────────────────────────────
.pytest_cache/

# ─── Model Weights: ALL tracked so teammates can run without re-downloading ───
# yolov8n.pt              (6.2 MB)  – YOLO object detection
# yolov8n-pose.pt         (6.5 MB)  – YOLO athlete pose estimation
# pose_landmarker_full.task (9 MB)  – MediaPipe BlazePose 3D model
# model/badminton_detector_v1.pt (21.5 MB) – Custom badminton detector
#
# All model files are tracked in git (no *.pt exclusion).

# ─── Training Output (not needed by teammates) ────────────────────────────────
runs/

# ─── Data: raw videos and processed outputs are NOT pushed (too large) ────────
data/raw/*
data/processed/*
data/datasets/*
data/outputs/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/datasets/.gitkeep
!data/outputs/.gitkeep

# ─── Node.js: teammates run `npm install` inside frontend/ ───────────────────
node_modules/
frontend/node_modules/

# ─── Frontend Build Artifact (teammates build with `npm run build`) ───────────
frontend/dist/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ─── IDE & OS Files ───────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db